# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Database files & Instance folder
*.db
*.sqlite
*.sqlite3
instance/
dms.db

# Environment variables, secrets, and credentials
.env
.env.*
*.env
*.key
*.pem
secrets.json

# Temporary Snapshots & Alerts
app/static/snapshots/*
!app/static/snapshots/.gitkeep

# Datasets and custom recordings
dataset/*.csv
dataset/*.jpg
dataset/*.jpeg
dataset/*.png
dataset/raw_images/**
!dataset/raw_images/.gitkeep
!dataset/.gitkeep

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Agent, Tooling & IDE internal caches
.agents/
.gemini/
.idea/
.vscode/
*.swp
*.swo

# Logs and runtime databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

