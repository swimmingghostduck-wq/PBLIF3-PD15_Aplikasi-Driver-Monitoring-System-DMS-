# Konfigurasi AI Service (salin menjadi .env lalu sesuaikan)
# Semua variabel memakai prefix DMS_

DMS_APP_NAME="DMS AI Service"
DMS_DEBUG=true
DMS_HOST=127.0.0.1
DMS_PORT=8001

# CORS: alamat aplikasi Laravel yang boleh mengakses service ini
DMS_CORS_ORIGINS=["http://localhost:8000"]

# Threshold deteksi kantuk (FR-05 / NFR-05)
DMS_FACE_LANDMARKER_MODEL=models/face_landmarker.task
DMS_EAR_THRESHOLD=0.21
DMS_DROWSY_FRAME_THRESHOLD=20
DMS_MAR_THRESHOLD=0.60

# Threshold arah pandangan/kepala (FR-06)
DMS_YAW_THRESHOLD_DEG=30.0
DMS_PITCH_THRESHOLD_DEG=25.0
DMS_DISTRACTED_FRAME_THRESHOLD=15

# Deteksi objek (FR-07/FR-08) - opsional
DMS_YOLO_ENABLED=false
DMS_YOLO_WEIGHTS=models/yolov8n.pt
DMS_UNSAFE_DISTANCE_M=5.0
